{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "row",
  "font": "Liberation Mono",
  "font_size": 14,
  "ui_font": "Liberation Sans",
  "terminal_menu": "spaces-status",
  "toast": "spaces-status",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "spaces-status",
            "props": {
              "chrome": "brand"
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "spaces-status"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "spaces-status",
            "props": {
              "chrome": "footer"
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 299
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "spaces-status",
            "props": {
              "chrome": "tabs"
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "spaces-status",
                      "props": {
                        "chrome": "pane"
                      }
                    },
                    "reveal": "always",
                    "height": 32,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 2,
                    "color": "border"
                  },
                  "focus": {
                    "width": 2,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "spaces-status",
                        "props": {
                          "view": "files"
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "spaces-status",
                        "props": {
                          "view": "changes"
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "spaces-status",
            "props": {
              "chrome": "status"
            }
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 2,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": {
    "light": "paper",
    "dark": "ink"
  }
}
